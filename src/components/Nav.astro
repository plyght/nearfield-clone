---
import Logo from "./Logo.astro";
import "../styles/components/logo.css";
---

<header
  class="relative z-20 mx-auto flex w-full max-w-[980px] items-center justify-between px-5 py-4 sm:px-14"
>
  <a href="/" class="header-brand flex items-center gap-2.5" aria-label="Nearfield home">
    <Logo class="size-[22px] text-white" />
    <span class="header-brand-text hidden text-[15px] font-medium text-white sm:inline">
      Nearfield
    </span>
  </a>

  <nav class="flex items-center gap-1 text-[13px] font-medium text-muted sm:gap-2">
    <a
      href="/#download"
      class="whitespace-nowrap rounded-full bg-white/8 px-3 py-1.5 text-white transition-colors duration-200 hover:bg-white/12 sm:px-3.5"
    >
      Get for Mac
    </a>
    <a
      href="/faqs"
      class="inline-block rounded-full px-2 py-1.5 transition-colors duration-200 hover:text-white sm:px-3"
    >
      FAQs
    </a>
    <a
      href="https://github.com/kemuri/nearfield"
      aria-label="Nearfield app source on GitHub"
      title="Nearfield app source on GitHub"
      class="inline-flex items-center rounded-full px-2 py-1.5 transition-colors duration-200 hover:text-white sm:px-3"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
        <path
          d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
        ></path>
      </svg>
    </a>

    <button
      type="button"
      data-sound-nav
      aria-pressed="true"
      aria-label="Mute sound"
      title="Mute sound"
      class="inline-flex items-center rounded-full px-2 py-1.5 transition-colors duration-200 hover:text-white sm:px-3"
    >
      <svg
        data-sound-nav-on
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-4"
        aria-hidden="true"
      >
        <path
          d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"
        ></path>
        <path d="M16 9a5 5 0 0 1 0 6"></path>
        <path d="M19.364 18.364a9 9 0 0 0 0-12.728"></path>
      </svg>
      <svg
        data-sound-nav-off
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="hidden size-4"
        aria-hidden="true"
      >
        <path
          d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"
        ></path>
        <line x1="22" x2="16" y1="9" y2="15"></line>
        <line x1="16" x2="22" y1="9" y2="15"></line>
      </svg>
    </button>

    <button
      type="button"
      data-theme-nav
      aria-label="Switch to light mode"
      title="Switch to light mode"
      class="inline-flex items-center rounded-full px-2 py-1.5 transition-colors duration-200 hover:text-white sm:px-3"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-4"
        aria-hidden="true"
        data-theme-nav-sun
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path>
        <path d="m17.66 17.66 1.41 1.41"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m6.34 17.66-1.41 1.41"></path>
        <path d="m19.07 4.93-1.41 1.41"></path>
      </svg>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="hidden size-4"
        aria-hidden="true"
        data-theme-nav-moon
      >
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
      </svg>
    </button>
  </nav>
</header>

<script>
  import { initThemeToggle } from "../scripts/theme";

  const SOUND_KEY = "nearfield:sound-enabled";
  const button = document.querySelector<HTMLButtonElement>("[data-sound-nav]");
  const onIcon = document.querySelector("[data-sound-nav-on]");
  const offIcon = document.querySelector("[data-sound-nav-off]");

  function render(on: boolean): void {
    button?.setAttribute("aria-pressed", String(on));
    if (button) {
      const label = on ? "Mute sound" : "Unmute sound";
      button.title = label;
      button.setAttribute("aria-label", label);
    }
    onIcon?.classList.toggle("hidden", !on);
    offIcon?.classList.toggle("hidden", on);
  }

  function persist(on: boolean): void {
    try {
      localStorage.setItem(SOUND_KEY, JSON.stringify(on));
    } catch {}
  }

  try {
    const stored = localStorage.getItem(SOUND_KEY);
    render(stored == null ? true : JSON.parse(stored) === true);
  } catch {
    render(true);
  }

  document.addEventListener("nearfield:sound-changed", (event) => {
    render(!!(event as CustomEvent).detail?.on);
  });

  button?.addEventListener("click", () => {
    const next = button.getAttribute("aria-pressed") !== "true";
    render(next);
    persist(next);
    document.dispatchEvent(new CustomEvent("nearfield:sound-set", { detail: { on: next } }));
  });

  initThemeToggle({
    button: document.querySelector("[data-theme-nav]"),
    sunIcon: document.querySelector("[data-theme-nav-sun]"),
    moonIcon: document.querySelector("[data-theme-nav-moon]"),
    hiddenClass: "hidden",
    themeColor: { light: "#f2f1ef", dark: "#0a0a0a" },
  });
</script>
