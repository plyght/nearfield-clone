---
import "../styles/components/bottom-cta.css";
import BuyButton from "./BuyButton.astro";

const MARK_PATH =
  "M22.8687 12.5584C26.9273 5.52872 37.0728 5.52873 41.1314 12.5584L56.3394 38.8972C60.3979 45.9268 55.3245 54.7143 47.2076 54.7146H16.7926C8.67565 54.7143 3.60221 45.9268 7.66072 38.8972L22.8687 12.5584ZM32.0006 19.7107C23.3248 19.7107 16.2908 26.7439 16.2906 35.4197C16.2906 44.0956 23.3246 51.1296 32.0006 51.1296C40.6763 51.1294 47.7095 44.0955 47.7095 35.4197C47.7093 26.7441 40.6762 19.7109 32.0006 19.7107Z";
---

<section
  id="download"
  class="bottom-cta relative mx-auto mt-10 min-h-[500px] w-full max-w-[980px] overflow-hidden px-5 pt-20 sm:mt-14 sm:min-h-[400px] sm:px-6 sm:pt-12"
>
  <div class="relative z-10 flex flex-col items-center gap-5 text-center">
    <BuyButton size="lg" variant="white" label="Get for Mac" />
    <p class="text-[13px] tracking-[-0.01em] text-faint">
      Free and open source • Requires macOS 14 or later
    </p>
  </div>

  <!-- Oversized watermark, clipped at the bottom. Two layers let the top fade
       remain crisp while the lower portion progressively blurs into the crop. -->
  <div
    class="bottom-cta-mark pointer-events-none absolute inset-x-0 z-0 flex justify-center"
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 64 64"
      width="64"
      height="64"
      fill="none"
      class="bottom-cta-mark-sharp h-[390px] w-auto text-white/[0.045] sm:h-[470px]"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d={MARK_PATH} fill="currentColor"></path>
    </svg>
    <svg
      viewBox="0 0 64 64"
      width="64"
      height="64"
      fill="none"
      class="bottom-cta-mark-blur absolute h-[390px] w-auto text-white/[0.05] sm:h-[470px]"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d={MARK_PATH} fill="currentColor"></path>
    </svg>
  </div>
</section>
