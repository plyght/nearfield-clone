---
import "../styles/components/buy-button.css";

interface Props {
  size?: "md" | "lg";
  variant?: "hero" | "white" | "compare";
  label?: string;
  href?: string;
  class?: string;
}

const {
  size = "md",
  variant,
  label = "Get for Mac",
  // Checkout was dropped from this clone, so the CTA points at the release
  // instead of opening a payment dialog.
  href = "https://github.com/kemuri/nearfield/releases",
  class: className = "",
} = Astro.props;

const classes = ["buy-btn", `buy-btn--${size}`, variant ? `buy-btn--${variant}` : "", className]
  .filter(Boolean)
  .join(" ");
---

<a href={href} class={classes} data-wave-trigger>
  <span class="buy-apple" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.464 2.338-1.282 3.714 1.345.104 2.715-.688 3.57-1.701z"
      ></path>
    </svg>
  </span>

  <span class="buy-label">{label}</span>

  <span class="buy-arrow" aria-hidden="true">
    <svg viewBox="0 0 26 26" fill="none">
      <circle cx="13" cy="13" r="12" stroke="currentColor" stroke-width="1.7"></circle>
      <path
        d="M7 13h9.5M12.5 8.4l4.6 4.6-4.6 4.6"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</a>
