---
import { TEMPLATES, DEFAULTS, baseNoise } from "../scripts/drumPatterns";

const rows = DEFAULTS.rows;
const cols = DEFAULTS.cols;

// Seed the first paint with the same pattern the client would build, so the
// grid is correct before hydration instead of flashing empty.
const active = new Set(TEMPLATES[DEFAULTS.template].build(rows, cols));

const cells = Array.from({ length: rows * cols }, (_, i) => {
  const row = Math.floor(i / cols);
  const col = i % cols;
  return { row, col, on: active.has(`${row},${col}`), base: baseNoise(row, col) };
});

const THEMES = [
  { id: "tapedream", label: "Tape Dream", position: "first" },
  { id: "synthwave", label: "Synth Wave", position: "" },
  { id: "ambient", label: "Ambient", position: "last" },
];
---

