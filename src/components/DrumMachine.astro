            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    class="driver"
    data-driver
    data-rows={rows}
    data-cols={cols}
    style={`--rows: ${rows}; --cols: ${cols}`}
    role="group"
    aria-label="Lo-fi step sequencer"
  >
    <div class="matrix" data-grid>
      {
        cells.map((cell) => (
          <span
            class={cell.on ? "cell on" : "cell"}
            data-row={cell.row}
            data-col={cell.col}
            data-base={cell.base}
            style={`--base: ${cell.base}`}
          />
        ))
      }
    </div>
  </div>
</article>

<script>
  import { initDrumMachine } from "../scripts/drumMachine";
  import { initCards } from "../scripts/cards";

  const teardowns: Array<() => void> = [];
  document.querySelectorAll<HTMLElement>("[data-driver]").forEach((root) => {
    teardowns.push(initDrumMachine(root));
  });

  initCards();

  document.addEventListener("astro:before-swap", () => {
    while (teardowns.length) teardowns.pop()?.();
  });
</script>
