---
import Display from "./Display.astro";
import "../styles/components/scene.css";

/** Equalizer bars inside the draggable window, front to back. */
const BARS = [
  {
    opacity: 0.8,
    d: "M36.3765 20.526C37.197 20.526 37.8205 19.8697 37.8205 19.0657V14.5863C37.8205 13.7823 37.197 13.1096 36.3765 13.1096C35.5397 13.1096 34.9161 13.7823 34.9161 14.5863V19.0657C34.9161 19.8697 35.5397 20.526 36.3765 20.526Z",
  },
  {
    opacity: 0.6,
    d: "M29.3865 28.5668C30.207 28.5668 30.8469 27.9104 30.8469 27.1064V6.21909C30.8469 5.41511 30.207 4.74238 29.3865 4.74238C28.5498 4.74238 27.9427 5.41511 27.9427 6.21909V27.1064C27.9427 27.9104 28.5498 28.5668 29.3865 28.5668Z",
  },
  {
    opacity: 0.5,
    d: "M22.3969 22.6755C23.2337 22.6755 23.8572 22.0355 23.8572 21.2316V12.0759C23.8572 11.2719 23.2337 10.632 22.3969 10.632C21.5601 10.632 20.953 11.2719 20.953 12.0759V21.2316C20.953 22.0355 21.5601 22.6755 22.3969 22.6755Z",
  },
  {
    opacity: 0.4,
    d: "M15.4071 33.3246C16.2439 33.3246 16.8675 32.6683 16.8675 31.8642V1.46031C16.8675 0.656319 16.2439 0 15.4071 0C14.5867 0 13.9632 0.656319 13.9632 1.46031V31.8642C13.9632 32.6683 14.5867 33.3246 15.4071 33.3246Z",
  },
  {
    opacity: 0.3,
    d: "M8.41724 25.3993C9.25404 25.3993 9.89395 24.743 9.89395 23.9389V9.38512C9.89395 8.58112 9.25404 7.9084 8.41724 7.9084C7.59683 7.9084 6.98975 8.58112 6.98975 9.38512V23.9389C6.98975 24.743 7.59683 25.3993 8.41724 25.3993Z",
  },
  {
    opacity: 0.2,
    d: "M1.44391 20.7561C2.28071 20.7561 2.90422 20.0998 2.90422 19.2958V14.0288C2.90422 13.2248 2.28071 12.5521 1.44391 12.5521C0.607101 12.5521 0 13.2248 0 14.0288V19.2958C0 20.0998 0.607101 20.7561 1.44391 20.7561Z",
  },
];

const WINDOW_DOTS = [1.5, 6.5, 11.5];
---

<div class="scene" data-spatial>
  <div class="displays">
    <Display index={0} />
    <Display index={1} />
  </div>

  <!-- The window is clipped to the union of both screens so it visually
       disappears in the gap between displays while being dragged. -->
  <div class="window-mask" data-window-mask>
    <svg class="clip-defs" aria-hidden="true">
      <defs>
        <clipPath data-clip-path clipPathUnits="userSpaceOnUse">
          <rect data-clip-rect="0"></rect>
          <rect data-clip-rect="1"></rect>
        </clipPath>
      </defs>
    </svg>

    <div class="audio-window" data-window aria-label="Draggable spatial audio window" tabindex="0">
      <svg class="win-dots" viewBox="0 0 13 3" aria-hidden="true">
        {
          WINDOW_DOTS.map((cx) => (
            <circle cx={cx} cy="1.5" r="1.5" fill="white" fill-opacity="0.18" />
          ))
        }
      </svg>

      <svg class="win-wave" viewBox="0 0 38.4275 33.3248" aria-hidden="true">
        {
          BARS.map((bar) => (
            <path class="bar" opacity={bar.opacity} d={bar.d} fill="white" fill-opacity="0.85" />
          ))
        }
      </svg>
    </div>
  </div>
</div>

<script>
  import { initSpatialDisplay } from "../scripts/spatialDisplays";

  document.querySelectorAll<HTMLElement>("[data-spatial]").forEach(initSpatialDisplay);
</script>
